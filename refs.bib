@Inbook{Dieber2020,
author="Dieber, Bernhard
and White, Ruffin
and Taurer, Sebastian
and Breiling, Benjamin
and Caiazza, Gianluca
and Christensen, Henrik
and Cortesi, Agostino",
title="Penetration Testing ROS",
bookTitle="Robot Operating System (ROS): The Complete Reference (Volume 4)",
year="2020",
publisher="Springer International Publishing",
address="Cham",
chapter="831",
pages="183--225",
abstract="ROS is the most popular framework in robotics research and also grows in industrial use. This makes ROS a worthwhile target for attackers, especially since the core framework itself does not address security. Its open architecture and flexibility are also the reasons why ROS suffers from security issues. For example, in ROS, it is possible to isolate single nodes from the rest of the application without the ROS master, the other nodes, or even the node itself (i.e., its business code) noticing it. This is true for publishers, subscribers, and services alike. This makes attacks very difficult to spot at runtime. Penetration testing is the most common security testing practice. The goal is to test an application for possible security flaws. To better facilitate penetration testing for ROS, we introduce ROSPenTo and Roschaos, tools that use ROS vulnerabilities and demonstrate how an attacker can sabotage ROS applications. In this tutorial, you will learn about the ROS XML-RPC API, which is our main attack point. You will see, how API attacks on ROS work in depth. You will get to know Roschaos and ROSPentTo, two tools, which can be used to manipulate running ROS applications.",
isbn="978-3-030-20190-6",
doi="10.1007/978-3-030-20190-6\_8",
url="https://doi.org/10.1007/978-3-030-20190-6_8"
}

